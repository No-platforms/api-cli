# Copy to .env and fill in. Never commit the real .env.

# Server (HOST must stay 127.0.0.1 behind nginx)
PORT=3000
HOST=127.0.0.1

# Generate with: openssl rand -hex 32   (at least 32 characters)
API_KEY=

# A single program, absolute path, no arguments and no spaces.
CLI_COMMAND=/root/deploy-dev/deploy-dev.sh
CLI_WORKING_DIR=/root/deploy-dev

# Argument (the image tag) must match this pattern. Default is shown.
CLI_ARG_PATTERN=^[A-Za-z0-9._-]{1,128}$

# Maximum run time in milliseconds (default 30 minutes).
CLI_TIMEOUT_MS=1800000

# Requests per IP per 15 minutes.
RATE_LIMIT_MAX=100
